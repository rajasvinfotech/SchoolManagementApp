@page "/attendance"
@using SchoolManagementApp.Models
@using SchoolManagementApp.Services
@inject IDataService<Attendance> AttendanceService
@inject IDataService<Student> StudentService

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3>Attendance Management</h3>
        </div>
        <div class="col text-end">
            <button class="btn btn-primary" @onclick="ShowMarkAttendance">
                <i class="bi bi-calendar-check"></i> Mark Attendance
            </button>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-3">
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h6>Today Present</h6>
                    <h3>@TodayPresentCount</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <h6>Today Absent</h6>
                    <h3>@TodayAbsentCount</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <h6>Today Late</h6>
                    <h3>@TodayLateCount</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h6>Attendance %</h6>
                    <h3>@GetTodayAttendancePercentage()%</h3>
                </div>
            </div>
        </div>
    </div>

    @if (showMarkForm)
    {
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <h5><i class="bi bi-calendar-check"></i> Mark Attendance - @selectedDate.ToString("dd MMMM yyyy")</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Select Date</label>
                        <input type="date" class="form-control" @bind="selectedDate" @bind:event="oninput" @onchange="LoadAttendanceForDate" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Filter by Class</label>
                        <select class="form-select" @bind="filterClass">
                            <option value="">All Classes</option>
                            @foreach (var cls in GetUniqueClasses())
                            {
                                <option value="@cls">@cls</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Quick Actions</label>
                        <div class="btn-group w-100">
                            <button class="btn btn-success" @onclick="MarkAllPresent">
                                <i class="bi bi-check-all"></i> All Present
                            </button>
                            <button class="btn btn-danger" @onclick="MarkAllAbsent">
                                <i class="bi bi-x-lg"></i> All Absent
                            </button>
                        </div>
                    </div>
                </div>

                <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                    <table class="table table-bordered table-hover">
                        <thead class="table-dark sticky-top">
                            <tr>
                                <th>Roll No</th>
                                <th>Student Name</th>
                                <th>Class</th>
                                <th>Status</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in GetFilteredStudents())
                            {
                                var attendance = GetOrCreateAttendance(student);
                                <tr>
                                    <td>@student.RollNumber</td>
                                    <td><strong>@student.FirstName @student.LastName</strong></td>
                                    <td>@student.Class-@student.Section</td>
                                    <td>
                                        <select class="form-select form-select-sm @GetStatusClass(attendance.Status)" 
                                                @bind="attendance.Status">
                                            <option value="Present">✓ Present</option>
                                            <option value="Absent">✗ Absent</option>
                                            <option value="Late">⏰ Late</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" 
                                               @bind="attendance.Remarks" placeholder="Optional remarks..." />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-success" @onclick="SaveAttendance">
                        <i class="bi bi-save"></i> Save Attendance
                    </button>
                    <button class="btn btn-secondary" @onclick="CancelMarkForm">
                        <i class="bi bi-x-circle"></i> Cancel
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Attendance History -->
    <div class="card">
        <div class="card-header">
            <h5><i class="bi bi-clock-history"></i> Attendance History</h5>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <input type="text" class="form-control" placeholder="Search student..." 
                           @bind="searchTerm" @bind:event="oninput" />
                </div>
                <div class="col-md-3">
                    <input type="date" class="form-control" @bind="filterDate" @bind:event="oninput" />
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="filterStatusHistory">
                        <option value="">All Status</option>
                        <option value="Present">Present</option>
                        <option value="Absent">Absent</option>
                        <option value="Late">Late</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-secondary w-100" @onclick="ClearFilters">
                        <i class="bi bi-x"></i> Clear
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Date</th>
                            <th>Student Name</th>
                            <th>Status</th>
                            <th>Remarks</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in FilteredAttendanceHistory)
                        {
                            <tr>
                                <td>@record.Date.ToString("dd MMM yyyy")</td>
                                <td><strong>@record.StudentName</strong></td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(record.Status)">
                                        @record.Status
                                    </span>
                                </td>
                                <td>@(string.IsNullOrEmpty(record.Remarks) ? "-" : record.Remarks)</td>
                                <td>
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteAttendance(record.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!attendanceRecords.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="bi bi-info-circle"></i> No attendance records found. Start marking attendance!
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Attendance> attendanceRecords = new();
    private List<Student> students = new();
    private List<Attendance> tempAttendanceList = new();
    private bool showMarkForm = false;
    private DateTime selectedDate = DateTime.Today;
    private DateTime? filterDate = null;
    private string searchTerm = string.Empty;
    private string filterClass = string.Empty;
    private string filterStatusHistory = string.Empty;

    private int TodayPresentCount => attendanceRecords.Count(a => 
        a.Date.Date == DateTime.Today && a.Status == "Present");
    
    private int TodayAbsentCount => attendanceRecords.Count(a => 
        a.Date.Date == DateTime.Today && a.Status == "Absent");
    
    private int TodayLateCount => attendanceRecords.Count(a => 
        a.Date.Date == DateTime.Today && a.Status == "Late");

    private IEnumerable<Attendance> FilteredAttendanceHistory =>
        attendanceRecords
            .Where(a =>
                (!filterDate.HasValue || a.Date.Date == filterDate.Value.Date) &&
                (string.IsNullOrWhiteSpace(filterStatusHistory) || a.Status == filterStatusHistory) &&
                (string.IsNullOrWhiteSpace(searchTerm) ||
                a.StudentName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(a => a.Date);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        attendanceRecords = await AttendanceService.GetAllAsync();
        students = await StudentService.GetAllAsync();
    }

    private void ShowMarkAttendance()
    {
        selectedDate = DateTime.Today;
        LoadAttendanceForDate();
        showMarkForm = true;
    }

    private void LoadAttendanceForDate()
    {
        tempAttendanceList.Clear();
        
        foreach (var student in students.Where(s => s.IsActive))
        {
            var existingAttendance = attendanceRecords.FirstOrDefault(a =>
                a.StudentId == student.Id && a.Date.Date == selectedDate.Date);

            if (existingAttendance != null)
            {
                tempAttendanceList.Add(new Attendance
                {
                    Id = existingAttendance.Id,
                    StudentId = existingAttendance.StudentId,
                    StudentName = existingAttendance.StudentName,
                    Date = existingAttendance.Date,
                    Status = existingAttendance.Status,
                    Remarks = existingAttendance.Remarks
                });
            }
            else
            {
                tempAttendanceList.Add(new Attendance
                {
                    StudentId = student.Id,
                    StudentName = $"{student.FirstName} {student.LastName}",
                    Date = selectedDate,
                    Status = "Present"
                });
            }
        }
    }

    private IEnumerable<Student> GetFilteredStudents()
    {
        return students
            .Where(s => s.IsActive && 
                (string.IsNullOrWhiteSpace(filterClass) || s.Class == filterClass))
            .OrderBy(s => s.RollNumber);
    }

    private Attendance GetOrCreateAttendance(Student student)
    {
        return tempAttendanceList.FirstOrDefault(a => a.StudentId == student.Id) 
            ?? new Attendance
            {
                StudentId = student.Id,
                StudentName = $"{student.FirstName} {student.LastName}",
                Date = selectedDate,
                Status = "Present"
            };
    }

    private void MarkAllPresent()
    {
        foreach (var attendance in tempAttendanceList)
        {
            attendance.Status = "Present";
        }
    }

    private void MarkAllAbsent()
    {
        foreach (var attendance in tempAttendanceList)
        {
            attendance.Status = "Absent";
        }
    }

    private async Task SaveAttendance()
    {
        foreach (var attendance in tempAttendanceList)
        {
            var existing = attendanceRecords.FirstOrDefault(a =>
                a.StudentId == attendance.StudentId && a.Date.Date == selectedDate.Date);

            if (existing != null)
            {
                existing.Status = attendance.Status;
                existing.Remarks = attendance.Remarks;
                await AttendanceService.UpdateAsync(existing);
            }
            else
            {
                await AttendanceService.AddAsync(attendance);
            }
        }

        await LoadData();
        showMarkForm = false;
        tempAttendanceList.Clear();
    }

    private void CancelMarkForm()
    {
        showMarkForm = false;
        tempAttendanceList.Clear();
    }

    private async Task DeleteAttendance(string id)
    {
        bool confirmed = await App.Current.MainPage.DisplayAlert(
            "Confirm Delete",
            "Are you sure you want to delete this attendance record?",
            "Yes",
            "No");

        if (confirmed)
        {
            await AttendanceService.DeleteAsync(id);
            await LoadData();
        }
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        filterDate = null;
        filterStatusHistory = string.Empty;
    }

    private List<string> GetUniqueClasses()
    {
        return students
            .Where(s => !string.IsNullOrWhiteSpace(s.Class))
            .Select(s => s.Class)
            .Distinct()
            .OrderBy(c => c)
            .ToList();
    }

    private string GetStatusClass(string status) => status switch
    {
        "Present" => "border-success",
        "Absent" => "border-danger",
        "Late" => "border-warning",
        _ => ""
    };

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Present" => "bg-success",
        "Absent" => "bg-danger",
        "Late" => "bg-warning",
        _ => "bg-secondary"
    };

    private string GetTodayAttendancePercentage()
    {
        var total = TodayPresentCount + TodayAbsentCount + TodayLateCount;
        if (total == 0) return "0";
        return ((TodayPresentCount * 100.0) / total).ToString("F1");
    }
}